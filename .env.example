# Database (default: SQLite — no Docker required)
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-for-production"

# Optional (Docker/Postgres)
# DB_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unified_creator_stats?schema=public"

# App base URL (stable for OAuth redirects; use port 3000 for Fanvue)
APP_BASE_URL="http://localhost:3000"

# Fanvue OAuth — paste Client ID and Secret from Fanvue; PKCE (S256) and scopes openid offline_access offline are required
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# Defaults (per Fanvue Implementation Guide): auth.fanvue.com for OAuth, api.fanvue.com for API
FANVUE_AUTHORIZATION_URL=https://auth.fanvue.com/oauth2/auth
FANVUE_TOKEN_URL=https://auth.fanvue.com/oauth2/token
FANVUE_API_BASE_URL=https://api.fanvue.com
# Fanvue API version header (required by API)
FANVUE_API_VERSION=2025-06-26
# Scopes requested at login. If unset, app requests: read:creator read:insights read:agency read:self (required for /creators, earnings). Override to add e.g. write:agency read:post
# After changing, click Reconnect in Settings so Fanvue issues a new token with these scopes.
FANVUE_SCOPES="read:creator read:insights read:agency read:self"

# Optional: for future OAuth providers
# INFLOWW_CLIENT_ID=
# INFLOWW_CLIENT_SECRET=
